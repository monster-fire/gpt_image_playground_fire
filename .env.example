# 必填：应用登录密码。不要使用 VITE_ 前缀；VITE_* 会进入前端静态包。
APP_PASSWORD=change-this-password

# 浏览器实际访问本应用的地址。内网 HTTP 示例：
APP_ORIGIN=http://192.168.0.121:11130

# 内网 HTTP 测试设为 false；HTTPS 或反向代理 TLS 部署应设为 true。
COOKIE_SECURE=false

# 同源 API 代理。供应商 Key 保存在 NAS 配置文件中，不写进静态包。
ENABLE_API_PROXY=true
API_PROXY_URL=https://api.openai.com/v1

# 宿主机端口。compose.yaml 会把 ./config 和 ./data 挂载到容器 /config、/data。
PORT=11130

# 本地 npm run start / npm run dev 共用。Docker Compose 会覆盖为容器内路径。
API_CONFIG_PATH=./config/gpt-image-playground.json
DATA_DIR=./data
NAS_DEV_SERVER_URL=http://127.0.0.1:3000
